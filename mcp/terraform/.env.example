# API 키. ./setup_keys.sh 가 이 값들을 Secret Manager에 넣는다.
# Terraform 변수가 아니므로 tfstate에는 남지 않는다.
#
#   cp .env.example .env && vi .env
#   set -a && . ./.env && set +a
#   ./setup_keys.sh --apply
#
# 이 파일에 실제 키를 적고 커밋하지 말 것 (.env는 .gitignore에 있음).

# 한국은행 ECOS  https://ecos.bok.or.kr/api/
export TF_VAR_ecos_api_key="YOUR_ECOS_KEY"

# 금융감독원 OPEN DART (40자)  https://opendart.fss.or.kr/
export TF_VAR_dart_api_key="YOUR_DART_KEY"

# 공공데이터포털 주식시세  https://www.data.go.kr/
# '+', '/', '=' 포함 디코딩 형태를 그대로. 퍼센트 인코딩하지 말 것.
export TF_VAR_stock_api_key="YOUR_STOCK_KEY"

# 금융감독원 금융상품통합비교공시  https://finlife.fss.or.kr/
export TF_VAR_finlife_api_key="YOUR_FINLIFE_KEY"
